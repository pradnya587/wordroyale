# Copy to .env and change the secrets before deploying.

# Shared by auth-service (signs tokens) and game-service / stats-service (verify them).
JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_USER=wordroyale
POSTGRES_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Where CI/CD pushes images (GitHub Container Registry). Lowercase.
REGISTRY=ghcr.io/your-github-username
TAG=latest

# Game tuning (optional). Round order: word chain, letter builder, speed round.
ROUND_DURATIONS_MS=45000,60000,20000
INTERMISSION_MS=7000
RECONNECT_GRACE_MS=30000
